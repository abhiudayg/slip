{
  "formatVersion": 1,
  "passTypeIdentifier": "{{PASS_TYPE_IDENTIFIER}}",
  "teamIdentifier": "{{TEAM_IDENTIFIER}}",
  "organizationName": "redBus",
  "description": "redBus intercity ticket",
  "logoText": "redBus",
  "backgroundColor": "rgb(37, 13, 17)",
  "foregroundColor": "rgb(255, 255, 255)",
  "labelColor": "rgb(255, 170, 130)",
  "transitType": "PKTransitTypeBus",
  "barcode": {
    "format": "PKBarcodeFormatQR",
    "message": "{{qr_data}}",
    "messageEncoding": "iso-8859-1",
    "altText": "{{pnr}}"
  },
  "boardingPass": {
    "headerFields": [
      { "key": "pnr", "label": "PNR", "value": "{{pnr}}" }
    ],
    "primaryFields": [
      { "key": "origin", "label": "BOARDING", "value": "{{origin}}" },
      { "key": "destination", "label": "DROP OFF", "value": "{{destination}}" }
    ],
    "secondaryFields": [
      { "key": "dep", "label": "DEPARTURE", "value": "{{dep}}" },
      { "key": "arr", "label": "ARRIVAL", "value": "{{arr}}" }
    ],
    "auxiliaryFields": [
      { "key": "seat", "label": "SEAT", "value": "{{seat}}" },
      { "key": "passenger", "label": "PASSENGER", "value": "{{passenger}}" },
      { "key": "bus", "label": "BUS", "value": "{{bus}}" },
      { "key": "duration", "label": "DURATION", "value": "{{duration}}" }
    ],
    "backFields": [
      {
        "key": "about",
        "label": "About",
        "value": "Show this pass when boarding. Conductor e-verify via QR. Live GPS can sync to Dynamic Island when enabled."
      }
    ]
  }
}
