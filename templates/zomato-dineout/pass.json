      },
      {
        "key": "city",
        "label": "City",
        "value": "{{city}}"
      },
      {
        "key": "special_tag",
        "label": "Special",
        "value": "{{special_tag}}"
      },
      {
        "key": "cuisine",
        "label": "Cuisine",
        "value": "{{cuisine}}"
      },
      {
        "key": "grace_period",
        "label": "Grace",
        "value": "{{grace_period}}"
      },
      {
        "key": "guest",
