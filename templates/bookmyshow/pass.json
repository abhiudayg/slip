{
  "formatVersion": 1,
  "passTypeIdentifier": "{{PASS_TYPE_IDENTIFIER}}",
  "teamIdentifier": "{{TEAM_IDENTIFIER}}",
  "organizationName": "BookMyShow",
  "description": "BookMyShow cinema ticket",
  "logoText": "BookMyShow",
  "backgroundColor": "rgb(36, 12, 22)",
  "foregroundColor": "rgb(255, 255, 255)",
  "labelColor": "rgb(255, 120, 160)",
  "barcode": {
    "format": "PKBarcodeFormatQR",
    "message": "{{qr_data}}",
    "messageEncoding": "iso-8859-1",
    "altText": "{{booking_id}}"
  },
  "eventTicket": {
    "primaryFields": [
      { "key": "event", "label": "EVENT", "value": "{{event}}" }
    ],
    "secondaryFields": [
      { "key": "venue", "label": "CINEMA / AUDI", "value": "{{venue}}" },
      { "key": "seat", "label": "SEATS", "value": "{{seat}}" }
    ],
    "auxiliaryFields": [
      { "key": "time", "label": "SHOWTIME", "value": "{{time}}" },
      { "key": "booking", "label": "BOOKING ID", "value": "{{booking_id}}" }
    ],
    "backFields": [
      { "key": "about", "label": "Turnstile", "value": "Scan at audi turnstile. Brightness maximizes at venue." }
    ]
  }
}
