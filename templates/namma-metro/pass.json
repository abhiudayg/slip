{
  "formatVersion": 1,
  "passTypeIdentifier": "{{PASS_TYPE_IDENTIFIER}}",
  "teamIdentifier": "{{TEAM_IDENTIFIER}}",
  "organizationName": "Namma Metro",
  "description": "Namma Metro QR single journey",
  "logoText": "Namma Metro",
  "backgroundColor": "rgb(28, 16, 48)",
  "foregroundColor": "rgb(255, 255, 255)",
  "labelColor": "rgb(190, 150, 255)",
  "barcode": {
    "format": "PKBarcodeFormatQR",
    "message": "{{qr_data}}",
    "messageEncoding": "iso-8859-1",
    "altText": "{{booking_id}}"
  },
  "boardingPass": {
    "transitType": "PKTransitTypeGeneric",
    "headerFields": [
      { "key": "type", "label": "TICKET TYPE", "value": "QR SINGLE JOURNEY" }
    ],
    "primaryFields": [
      { "key": "origin", "label": "ORIGIN STATION", "value": "{{origin}}" },
      { "key": "destination", "label": "DESTINATION", "value": "{{destination}}" }
    ],
    "secondaryFields": [
      { "key": "issued", "label": "ISSUED AT", "value": "{{dep}}" },
      { "key": "valid", "label": "VALID TILL", "value": "{{arr}}" }
    ],
    "auxiliaryFields": [
      { "key": "token", "label": "TOKEN / PASS ID", "value": "{{qr_data}}" }
    ],
    "backFields": [
      { "key": "about", "label": "Turnstile", "value": "Screen brightness maximizes at the turnstile. Metro station geofencing active." }
    ]
  }
}
