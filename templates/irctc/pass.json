{
  "formatVersion": 1,
  "passTypeIdentifier": "{{PASS_TYPE_IDENTIFIER}}",
  "teamIdentifier": "{{TEAM_IDENTIFIER}}",
  "organizationName": "IRCTC",
  "description": "IRCTC e-ticket",
  "logoText": "IRCTC",
  "backgroundColor": "rgb(30, 27, 75)",
  "foregroundColor": "rgb(255, 255, 255)",
  "labelColor": "rgb(196, 181, 253)",
  "transitType": "PKTransitTypeTrain",
  "barcode": {
    "format": "PKBarcodeFormatQR",
    "message": "{{qr_data}}",
    "messageEncoding": "iso-8859-1",
    "altText": "PNR {{pnr}}"
  },
  "boardingPass": {
    "headerFields": [
      { "key": "train", "label": "TRAIN", "value": "{{train}}" },
      { "key": "coach", "label": "COACH", "value": "{{coach}}" }
    ],
    "primaryFields": [
      { "key": "origin", "label": "FROM", "value": "{{origin}}" },
      { "key": "destination", "label": "TO", "value": "{{destination}}" }
    ],
    "secondaryFields": [
      { "key": "passenger", "label": "PASSENGER", "value": "{{passenger}}" },
      { "key": "seat", "label": "BERTH", "value": "{{seat}}" }
    ],
    "auxiliaryFields": [
      { "key": "pnr", "label": "PNR", "value": "{{pnr}}" }
    ],
    "backFields": [
      { "key": "about", "label": "About", "value": "Built from your IRCTC booking PDF or SMS screenshot." }
    ]
  }
}
