{
  "formatVersion": 1,
  "passTypeIdentifier": "{{PASS_TYPE_IDENTIFIER}}",
  "teamIdentifier": "{{TEAM_IDENTIFIER}}",
  "organizationName": "IndiGo",
  "description": "IndiGo boarding pass",
  "logoText": "IndiGo",
  "backgroundColor": "rgb(0, 29, 49)",
  "foregroundColor": "rgb(255, 255, 255)",
  "labelColor": "rgb(170, 199, 255)",
  "transitType": "PKTransitTypeAir",
  "barcode": {
    "format": "PKBarcodeFormatAztec",
    "message": "{{qr_data}}",
    "messageEncoding": "iso-8859-1",
    "altText": "{{pnr}}"
  },
  "boardingPass": {
    "headerFields": [
      {
        "key": "flight",
        "label": "FLIGHT",
        "value": "{{flight}}"
      },
      {
        "key": "gate",
        "label": "GATE",
        "value": "{{gate}}"
      }
    ],
    "primaryFields": [
      {
        "key": "origin",
        "label": "FROM",
        "value": "{{origin}}"
      },
      {
        "key": "destination",
        "label": "TO",
        "value": "{{destination}}"
      }
    ],
    "secondaryFields": [
      {
        "key": "passenger",
        "label": "PASSENGER",
        "value": "{{passenger}}"
      },
      {
        "key": "seat",
        "label": "SEAT",
        "value": "{{seat}}"
      }
    ],
    "auxiliaryFields": [
      {
        "key": "pnr",
        "label": "PNR",
        "value": "{{pnr}}"
      }
    ],
    "backFields": [
      {
        "key": "about",
        "label": "About",
        "value": "Built from your booking PDF or screenshot. Surfaces near departure."
      }
    ]
  }
}
