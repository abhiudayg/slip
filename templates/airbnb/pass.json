{
  "formatVersion": 1,
  "passTypeIdentifier": "{{PASS_TYPE_IDENTIFIER}}",
  "teamIdentifier": "{{TEAM_IDENTIFIER}}",
  "organizationName": "Airbnb",
  "description": "Airbnb room key & access pass",
  "logoText": "Airbnb",
  "backgroundColor": "rgb(33, 18, 22)",
  "foregroundColor": "rgb(255, 255, 255)",
  "labelColor": "rgb(255, 150, 170)",
  "barcode": {
    "format": "PKBarcodeFormatQR",
    "message": "{{qr_data}}",
    "messageEncoding": "iso-8859-1",
    "altText": "{{booking_id}}"
  },
  "generic": {
    "headerFields": [
      { "key": "status", "label": "KEY STATUS", "value": "ACTIVE" }
    ],
    "primaryFields": [
      { "key": "property", "label": "STAY", "value": "{{property}}" }
    ],
    "secondaryFields": [
      { "key": "checkin", "label": "CHECK-IN", "value": "{{check_in}}" },
      { "key": "checkout", "label": "CHECK-OUT", "value": "{{check_out}}" }
    ],
    "auxiliaryFields": [
      { "key": "guest", "label": "GUEST", "value": "{{guest}}" },
      { "key": "pin", "label": "DOOR PIN", "value": "{{door_pin}}" }
    ],
    "backFields": [
      { "key": "booking", "label": "Confirmation", "value": "{{booking_id}}" },
      { "key": "about", "label": "Access", "value": "Hold near the door lock for Apple VAS NFC unlock when available. Use door PIN as backup." }
    ]
  }
}
